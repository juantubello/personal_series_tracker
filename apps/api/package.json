{
  "name": "@pipiseries/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch --clear-screen=false src/server.ts",
    "dev:once": "node --experimental-sqlite --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.5.0",
    "jose": "^6.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5"
  }
}
