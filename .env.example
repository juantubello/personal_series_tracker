# API
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_PATH=./data/app.db

# TMDB credentials. Prefer TMDB_ACCESS_TOKEN when available.
# This is TMDB, not IMDb.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=es-AR
TMDB_FALLBACK_LANGUAGE=es-ES
TMDB_WATCH_REGION=AR

# Cloudflare Zero Trust production identity.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
JUAN_EMAIL=juan@local.pipiseries
CAMI_EMAIL=cami@local.pipiseries

# Local development identity.
ENABLE_DEV_AUTH=true
DEV_AUTH_EMAIL=juan@local.pipiseries

# Frontend local proxy target.
API_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=/api
